    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Caveats",
                    "textStyle": {
                      "fontSize": "18pt",
                      "color": "#2B2833",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Missing homelessness returns: up to about 30 councils miss a quarter. National and regional figures use MHCLG's published totals, which include estimates; council rates use only councils that reported.",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#2B2833"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Lettings totals: council-level lettings are as published in CORE Table 1d without the national adjustment, so 2024/25 (252,917) is below MHCLG's headline estimate of about 263,000.",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#2B2833"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Housing association stock only: the 2015 to 2025 trend excludes council-owned homes. Total social stock is available for 1 April 2024 only.",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#2B2833"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Denominators and boundaries: supply rates use the latest household estimates; all series use April 2024 council boundaries.",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#2B2833"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
